{"data":{"content":"/* All styling for the Animator app. The .gleam files only attach class names. */\n\n* { margin: 0; padding: 0; box-sizing: border-box; }\nhtml, body { width: 100%; height: 100%; overflow: hidden; }\n\n/* ── Layout: two columns ─────────────────────────────────────────────────── */\n\n.app {\n  display: flex;\n  width: 100vw;\n  height: 100vh;\n  background: #1a1a2e;\n  color: #d4c5a0;\n  font-family: system-ui, sans-serif;\n  font-size: 14px;\n}\n\n/* Left column: the code editor. */\n.code-col {\n  width: 42%;\n  min-width: 320px;\n  max-width: 720px;\n  flex-shrink: 0;\n  display: flex;\n  border-right: 1px solid #3a3a5e;\n  background: #0f0f1e;\n}\n\n/* The code column stays in the DOM when collapsed, so CodeMirror keeps its\n   state; hiding it gives the right column the full width. */\n.app.code-hidden .code-col { display: none; }\n\n/* A small emoji button (the code pane's collapse toggle, and the playback\n   controls once they exist). */\n.icon-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  background: #2a2a4a;\n  color: #d4c5a0;\n  border: 1px solid #4a4a8a;\n  border-radius: 4px;\n  cursor: pointer;\n  font-size: 14px;\n  line-height: 1;\n  padding: 5px 8px;\n}\n.icon-btn:hover { background: #3a3a5e; }\n\n/* ── Code panel (left column) ───────────────────────────────────────────── */\n\n.code-panel {\n  flex: 1;\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n}\n.code-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 10px 14px;\n  background: #1a1a3e;\n  border-bottom: 1px solid #3a3a5e;\n}\n.code-title {\n  color: #e8d8b0;\n  font-family: 'Georgia', serif;\n  font-size: 16px;\n  letter-spacing: 1px;\n}\n\n/* Wrapper holding the editor. */\n.code-editor-wrap {\n  flex: 1;\n  min-height: 0;\n  position: relative;\n  display: flex;\n}\n/* CodeMirror mount node: grows to fill the panel. */\n.code-editor {\n  flex: 1;\n  min-height: 0;\n  display: flex;\n  overflow: hidden;\n  background: #0d0d1a;\n}\n.code-editor .cm-editor { width: 100%; height: 100%; }\n\n/* Collapsible reference of the built-ins available to draw functions. */\n.reference {\n  margin: 8px 14px 0;\n  border: 1px solid #3a3a5e;\n  border-radius: 4px;\n  background: #0d0d1a;\n  overflow: hidden;\n}\n.reference-summary {\n  padding: 6px 12px;\n  cursor: pointer;\n  color: #b8a888;\n  font-family: monospace;\n  font-size: 12px;\n  user-select: none;\n}\n.reference-summary:hover { color: #e8d8b0; }\n.reference-body {\n  padding: 4px 12px 10px;\n  border-top: 1px solid #3a3a5e;\n}\n.reference-group { margin-top: 8px; }\n.reference-group-title {\n  color: #8a8aca;\n  font-family: monospace;\n  font-size: 11px;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n  margin-bottom: 4px;\n}\n.reference-row {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: baseline;\n  gap: 4px 10px;\n  padding: 1px 0;\n}\n.reference-sig {\n  color: #89ddff;\n  font-family: monospace;\n  font-size: 12px;\n  white-space: pre;\n}\n.reference-desc { color: #6a7a8a; font-size: 11px; }\n\n/* ── Animation area (right column) ──────────────────────────────────────── */\n\n.canvas-area {\n  flex: 1;\n  min-width: 0;\n  overflow: hidden;\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: #0a0a14;\n  container-type: size;\n}\n\n/* The interpreter's List(Path) (or its error), shown as text before the\n   animation pane is built. */\n.output {\n  align-self: stretch;\n  margin: 0;\n  padding: 16px;\n  overflow: auto;\n  font-family: ui-monospace, \"SF Mono\", Menlo, monospace;\n  font-size: 13px;\n  line-height: 1.5;\n  color: #cfe3ff;\n  white-space: pre-wrap;\n  word-break: break-word;\n}\n/* Leave room for the reveal button, which only overlays this pane while the\n   code column is hidden. */\n.app.code-hidden .output { padding-top: 48px; }\n\n/* Button that reveals the code column again when it is hidden. */\n.reveal-code {\n  position: absolute;\n  top: 12px;\n  left: 12px;\n  z-index: 10;\n}\n\n/* A centred square that fits the (possibly non-square) animation area. Give your\n   <canvas> this class, so that drawings aren't stretched. */\n.canvas {\n  width: min(100cqw, 100cqh);\n  height: min(100cqw, 100cqh);\n}\n\n","line_count":184,"path":"animator.css","sha256":"d1fa1f064ec221d959ae4a6cb9d0f2afd903771afcf0c525a9ebc85dce5a37ea"},"hash":"c66b32fadb4f57a997f200974b023f62397c6c7e9b873766b0412c1138e4879f","kind":"doc.open","prev_hash":"ae8f1b1e2647d9a10e48997772034a1c0f2a08377897eaabf829746e11d36009","seq":41,"t":32590,"wall":"2026-11-06T21:56:13.029Z"}
