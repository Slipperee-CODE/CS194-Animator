{"data":{"content":"// The things grader.gleam needs and Gleam cannot express: the command-line\n// arguments, running a test function without letting its panic (or its never\n// finishing) end the whole run silently, and the process exit code.\n//\n// Installed into a project's test/ directory from lib/gleam/grader_ffi.mjs in\n// the assignments repo; edit it there and not in the copy.\n\nimport { readFileSync, writeSync } from \"node:fs\";\nimport { Worker, isMainThread, workerData } from \"node:worker_threads\";\nimport { Result$Ok, Result$Error, toList } from \"./gleam.mjs\";\n\n// How long one test may run before the supervisor fails it and ends the run.\nconst TIMEOUT_MS = 2_000;\n\nexport function args() {\n  return toList(globalThis.Deno ? Deno.args : process.argv.slice(2));\n}\n\n// Run f, turning the panic a failed `assert` or `let assert` raises into an\n// Error holding the raised object. Gleam reads the details out of it (see\n// describe in grader.gleam), so nothing is formatted here.\nexport function rescue(name, f) {\n  watch(name);\n  try {\n    f();\n    return Result$Ok(undefined);\n  } catch (error) {\n    return Result$Error(error);\n  } finally {\n    watch(\"\");\n  }\n}\n\n// A test runs synchronously on its thread, so nothing on that thread can\n// interrupt one that never finishes. So the questions run on a worker thread,\n// which re-runs this program's entry script, while the main thread supervises:\n// they share a buffer holding a counter that changes whenever a test starts or\n// ends, and the running test's name (empty between tests). When the counter\n// stays put for TIMEOUT_MS while a test is running, the supervisor reports that\n// test as failed and ends the run. The process exits with the worker's code.\n//\n// Returns whether this thread is the supervisor, which must not run any tests.\nexport function supervise() {\n  if (globalThis.Deno) return false;\n  if (!isMainThread) {\n    // A worker's console.log is relayed through its event loop, which a test\n    // that never finishes blocks, losing the lines printed before it.\n    console.log = (...values) => writeSync(1, values.join(\" \") + \"\\n\");\n    return false;\n  }\n  const shared = new SharedArrayBuffer(8 + 256);\n  const state = new Int32Array(shared, 0, 2);\n  const worker = new Worker(process.argv[1], {\n    argv: process.argv.slice(2),\n    workerData: { shared },\n  });\n  let seen = -1;\n  let since = Date.now();\n  const timer = setInterval(() => {\n    const count = Atomics.load(state, 0);\n    const length = Atomics.load(state, 1);\n    if (count !== seen || length === 0) {\n      seen = count;\n      since = Date.now();\n    } else if (Date.now() - since >= TIMEOUT_MS) {\n      const name = Buffer.from(new Uint8Array(shared, 8, length)).toString();\n      console.log(`  FAIL  ${name}`);\n      console.log(\n        `        timed out after ${TIMEOUT_MS / 1000} seconds; ending the test run`,\n      );\n      clearInterval(timer);\n      worker.terminate();\n    }\n  }, 100);\n  worker.on(\"error\", (error) => console.error(error));\n  worker.on(\"exit\", (code) => {\n    clearInterval(timer);\n    process.exitCode = code;\n  });\n  return true;\n}\n\nfunction watch(name) {\n  const shared = workerData?.shared;\n  if (!shared) return;\n  const state = new Int32Array(shared, 0, 2);\n  const bytes = new TextEncoder().encode(name).slice(0, 256);\n  new Uint8Array(shared, 8).set(bytes);\n  Atomics.store(state, 1, bytes.length);\n  Atomics.add(state, 0, 1);\n}\n\n// The source text between two byte offsets of a file, which is how a failed\n// assertion locates its expressions. The file path is relative to the project\n// directory, found from this module's compiled location\n// (<project>/build/dev/javascript/<package>/) so it can be run from anywhere.\nexport function source(file, start, end) {\n  try {\n    const url = new URL(`../../../../${file}`, import.meta.url);\n    const bytes = readFileSync(url).subarray(start, end);\n    return Result$Ok(new TextDecoder().decode(bytes));\n  } catch {\n    return Result$Error(undefined);\n  }\n}\n\nexport function exit(code) {\n  if (globalThis.Deno) {\n    Deno.exit(code);\n  } else {\n    process.exit(code);\n  }\n}\n","line_count":114,"path":"test\\grader_ffi.mjs","sha256":"757e881e95a8d93942ef9b4f8822c53ebda1ae1fa9a8a75728cc267a6294e990"},"hash":"198a2fb6fb488e499fc55d3b30cdbeaa3017e3242382ffb0eaaa6237d27f465c","kind":"doc.open","prev_hash":"bb19b33d432a48acf37965b6f4b517a2562925bb5bbb5980f280b4b2307e55d0","seq":61,"t":61585,"wall":"2026-11-06T21:56:42.024Z"}
{"data":{"content":"//// Checks that the app has the elements that Gradescope's tests look for, so that\n//// a submission can be scored. They check nothing about how those elements behave:\n//// the tests that earn points for Problems 9 to 11 run only on Gradescope.\n////\n//// lustre/dev/simulate renders the app without a browser and never runs its\n//// Effects. These tests only need app to have public init, update, and view\n//// functions, so they don't depend on how the Model or Msg types are designed.\n\nimport app\nimport lustre/dev/query\nimport lustre/dev/simulate\n\nfn assert_rendered(selector: query.Selector, message: String) -> Nil {\n  let sim =\n    simulate.start(simulate.application(app.init, app.update, app.view), Nil)\n  case\n    query.find(\n      in: simulate.view(sim),\n      matching: query.element(matching: selector),\n    )\n  {\n    Ok(_) -> Nil\n    Error(Nil) -> panic as message\n  }\n}\n\n// Problem 9\n\npub fn canvas_id_test() {\n  assert_rendered(\n    query.and(query.tag(\"canvas\"), query.id(\"animation-canvas\")),\n    \"When the app opens, there is no <canvas id=\\\"animation-canvas\\\"> element. Add one to the view, using attr.id(\\\"animation-canvas\\\").\",\n  )\n}\n\npub fn code_editor_id_test() {\n  assert_rendered(\n    query.id(\"code-editor\"),\n    \"When the app opens, no element has the id \\\"code-editor\\\", which editor.view_panel provides. Keep it in the view.\",\n  )\n}\n\n// Problem 10\n\npub fn shape_slider_id_test() {\n  assert_rendered(\n    query.test_id(\"shape-slider\"),\n    \"When the app opens, no element has data-test-id=\\\"shape-slider\\\". Tag the slider that sets shape_slider with attr.attribute(\\\"data-test-id\\\", \\\"shape-slider\\\"), and keep it in the view.\",\n  )\n}\n\npub fn speed_slider_id_test() {\n  assert_rendered(\n    query.test_id(\"speed-slider\"),\n    \"When the app opens, no element has data-test-id=\\\"speed-slider\\\". Tag the speed slider with attr.attribute(\\\"data-test-id\\\", \\\"speed-slider\\\"), and keep it in the view.\",\n  )\n}\n\n// Problem 11\n\npub fn drawing_select_id_test() {\n  assert_rendered(\n    query.and(query.tag(\"select\"), query.test_id(\"drawing-select\")),\n    \"When the app opens, there is no <select> with data-test-id=\\\"drawing-select\\\". Tag the drop-down menu with attr.attribute(\\\"data-test-id\\\", \\\"drawing-select\\\").\",\n  )\n}\n","line_count":67,"path":"test\\test_ids_test.gleam","sha256":"dd56c0c7a1adc5be7a9e39e14fe72c8ef33db8889d58661d54719bd53eae8d65"},"hash":"c536e9cd9e7b28a693a33e1cc60f15ec4c0c5061ac2883a159de8eecde63b19c","kind":"doc.open","prev_hash":"198a2fb6fb488e499fc55d3b30cdbeaa3017e3242382ffb0eaaa6237d27f465c","seq":62,"t":62203,"wall":"2026-11-06T21:56:42.642Z"}
