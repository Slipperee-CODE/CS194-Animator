{"data":{"content":"// Reads extension.txt for extension_test.gleam. `gleam test` runs with cwd = the\n// Gleam project directory, so the path is relative to that.\n\nimport { existsSync, readFileSync } from \"node:fs\";\n\nconst DESCRIPTION = \"extension.txt\";\n\nexport function read_description() {\n  return existsSync(DESCRIPTION) ? readFileSync(DESCRIPTION, \"utf8\") : \"\";\n}\n\n","line_count":12,"path":"test\\extension_ffi.mjs","sha256":"3816d6bae25a6e25e38dba8a240f31a7f431bb03dbfe25fa8b7dff4d0a616ddc"},"hash":"82c651444b6604b1b30c7563cea0b7f4d01957588d786d0e9d54de0b3ee1df32","kind":"doc.open","prev_hash":"67c7c69d27f66b1da9757f87c5df85c6419e43e6015511aea5cc24701dd59c31","seq":58,"t":59787,"wall":"2026-11-06T21:56:40.226Z"}
