{"data":{"content":"//// Animator -- an application for program-generated drawings.\n\nimport builtins\nimport drawing\nimport editor\nimport errors\nimport gleam/result\nimport gleam/string\nimport lustre\nimport lustre/attribute as attr\nimport lustre/effect.{type Effect}\nimport lustre/element.{type Element}\nimport lustre/element/html\nimport lustre/event\nimport parser\nimport shape.{type Path}\n\n/// Your app's public address, once you've deployed it in Problem 13, such as\n/// \"https://your-username.github.io/animator/\".\npub const public_url = \"\"\n\n/// Set to True if you would like your app's URL included in the course gallery.\npub const include_app_in_gallery = False\n\n/// A link to your video from Problem 14, which anyone with the link can watch.\npub const video_url = \"\"\n\n/// Set to True if you would like your video included in the course gallery.\npub const include_video_in_gallery = False\n\nconst default_code = \"fn draw(shape_slider: Int) -> List(Path) {\\n  [Path(Line(Point(0, 0), Point(100, 100)), 0, 10, 2)]\\n}\\n\"\n\n// ── Model ──────────────────────────────────────────────────────────────────────\n\npub type Model {\n  Model(\n    // The code in the editor.\n    source: String,\n    // Whether the code editor is shown.\n    code_open: Bool,\n    output: String,\n  )\n}\n\npub type Msg {\n  SetCode(String)\n\n  // Layout controls\n  ToggleCode\n}\n\n// ── Init ───────────────────────────────────────────────────────────────────────\n\npub fn init(_flags: Nil) -> #(Model, Effect(Msg)) {\n  #(\n    Model(source: \"\", code_open: True, output: \"\"),\n    // Effects that happen automatically at the start go here.\n    effect.batch([\n      editor.mount(default_code, SetCode),\n      effect.from(fn(dispatch) { dispatch(SetCode(default_code)) }),\n    ]),\n  )\n}\n\n// Parse and evaluate a draw function at the given shape-slider value, returning\n// the rendered paths on success, or a human-readable message on failure.\nfn run_source(shape_slider: Int, source: String) -> Result(List(Path), String) {\n  case parser.parse_program(source, builtins.global_frame()) {\n    Error(msg) -> Error(msg)\n    Ok(program) ->\n      drawing.try_draw(shape_slider, program)\n      // Convert Error(EvalError) to Error(String) with a useful error message.\n      |> result.map_error(errors.error_message)\n  }\n}\n\n// ── Update ─────────────────────────────────────────────────────────────────────\n\npub fn update(model: Model, msg: Msg) -> #(Model, Effect(Msg)) {\n  case msg {\n    ToggleCode -> #(Model(..model, code_open: !model.code_open), effect.none())\n\n    // After each keystroke in the editor, evaluate user code and report errors.\n    SetCode(text) ->\n      case run_source(10, text) {\n        // Parsed and evaluated: show the result.\n        Ok(paths) -> #(\n          Model(..model, output: string.inspect(paths), source: text),\n          effect.none(),\n        )\n        // Broken (parse or evaluation): show the error.\n        Error(msg) -> #(\n          Model(..model, output: msg, source: text),\n          effect.none(),\n        )\n      }\n  }\n}\n\n// ── View ──────────────────────────────────────────────────────────────────\n//\n// Two side-by-side panes: the code editor on the left and its rendered output on\n// the right. The code column can be hidden to expand the right pane.\n\npub fn view(model: Model) -> Element(Msg) {\n  let app_class = case model.code_open {\n    True -> \"app\"\n    False -> \"app code-hidden\"\n  }\n  // The code column still exists even when hidden (CSS collapses it) so the\n  // mounted CodeMirror editor keeps its state across show/hide.\n  html.div([attr.class(app_class)], [\n    html.div([attr.class(\"code-col\")], [\n      editor.view_panel(ToggleCode),\n    ]),\n    view_anim(model),\n  ])\n}\n\nfn view_anim(model: Model) -> Element(Msg) {\n  html.div([attr.class(\"canvas-area\")], [\n    view_reveal_code(model),\n    html.pre([attr.class(\"output\")], [html.text(model.output)]),\n  ])\n}\n\n// The button that brings the code column back, overlaid on the top-left of the\n// right pane. Nothing is rendered while the column is already showing (its own\n// header holds the button that hides it).\nfn view_reveal_code(model: Model) -> Element(Msg) {\n  case model.code_open {\n    True -> element.none()\n    False ->\n      html.button(\n        [\n          attr.class(\"icon-btn reveal-code\"),\n          attr.attribute(\"title\", \"Show code\"),\n          event.on_click(ToggleCode),\n        ],\n        [html.text(\"⟩\")],\n      )\n  }\n}\n\n// ── Main ───────────────────────────────────────────────────────────────────────\n\npub fn main() -> Nil {\n  let app = lustre.application(init, update, view)\n  let assert Ok(_) = lustre.start(app, \"#app\", Nil)\n  Nil\n}\n","line_count":152,"path":"src\\app.gleam","sha256":"94c7d3b0d3af42f2308159e7cd06f72e004d5e4dab6c84b962484011c305544b"},"hash":"7f3e25cfc3f2f18ded27a19484ac1d3d5a36ed678736b382dbf665d9e92f5aa7","kind":"doc.open","prev_hash":"eda7f32e7cbea1cf51fdd67b9fa1ce48f6c0303a706768a3a5c4c744e0930b95","seq":78,"t":240575,"wall":"2026-11-06T21:59:41.014Z"}
{"data":{"path":"src\\app.gleam"},"hash":"179294ebf0c0d73bf1229752d259077de3768b109b2007b4f78906ca5a1bfe78","kind":"doc.close","prev_hash":"7f3e25cfc3f2f18ded27a19484ac1d3d5a36ed678736b382dbf665d9e92f5aa7","seq":79,"t":242979,"wall":"2026-11-06T21:59:43.417Z"}
{"data":{"content":"//// The interpreter, which evaluates the program that the parser produces.\n\nimport errors.{type EvalError, MissingFunction, TypeError}\nimport gleam/dict.{type Dict}\nimport gleam/int\nimport gleam/list\nimport gleam/option.{type Option, None, Some}\nimport gleam/result\nimport gleam/string\nimport limits\nimport mutable_dict.{type MutableDict}\n\n// ── Types ─────────────────────────────────────────────────────────────────────\n\n/// The value of an expression evaluated in an environment.\npub type Value {\n  VBool(Bool)\n  VInt(Int)\n  VList(List(Value))\n  // A record (e.g., a Point or Line). The tag indicates its type.\n  VData(tag: String, fields: List(Value))\n  VFunc(Callable)\n}\n\n/// A record type has a constructor name and a list of field names.\npub type Constructor =\n  #(String, List(String))\n\n/// Rather than supporting new types, this interpreter uses a fixed set.\npub const constructors: List(Constructor) = [\n  #(\"Point\", [\"x\", \"y\"]),\n  #(\"Line\", [\"start\", \"end\"]),\n  #(\"Path\", [\"shape\", \"start\", \"end\", \"thickness\"]),\n]\n\n/// The name-to-value bindings of a local frame (an immutable Gleam Dict).\npub type Bindings =\n  Dict(String, Value)\n\n/// The global frame is a mutable dictionary from names to values. It is mutable\n/// so that it can contain cycles: each top-level function in the global frame\n/// has the global frame as its env.\npub type GlobalFrame =\n  MutableDict(String, Value)\n\n/// An environment is a sequence of frames that includes a Local frame for each\n/// call to a user-defined function and a Global frame at the end.\npub type Env {\n  Local(bindings: Bindings, parent: Env)\n  Global(bindings: GlobalFrame)\n}\n\n/// A function value. A Builtin's run function implements its behavior, while a\n/// UserFn has a body Expr that is evaluated in a new frame whose parent is env.\npub type Callable {\n  Builtin(\n    name: String,\n    num_args: Int,\n    run: fn(List(Value)) -> Result(Value, EvalError),\n  )\n  UserFn(name: String, params: List(String), body: Expr, env: Env)\n}\n\n/// An Expr evaluates to a value when evaluated in an Env.\npub type Expr {\n  Var(String)\n  LiteralBool(Bool)\n  LiteralInt(Int)\n  // [a, b, ..rest] where the optional rest must evaluate to a list.\n  LiteralList(elems: List(Expr), rest: Option(Expr))\n  // f(x, y) where the fn_expr must evaluate to a function.\n  Call(fn_expr: Expr, operands: List(Expr))\n  // An anonymous function: fn(x, y) { ... }.\n  Lambda(params: List(String), body: Expr)\n  // A case expression: case subject { pattern -> expr }\n  Case(subject: Expr, arms: List(Arm))\n  // let name = value followed by body, the expression on the next line.\n  Let(name: String, value: Expr, body: Expr)\n  // Accessing a field value by name: p.x, line.start, etc.\n  FieldAccess(record: Expr, field: String)\n  // A source-line marker the parser adds around each let and each case arm so\n  // that error messages can include the line where an expression appeared.\n  At(line: Int, expr: Expr)\n}\n\n/// An arm of a case expression: a Pattern and the Expr evaluated if it matches.\npub type Arm =\n  #(Pattern, Expr)\n\n/// A pattern in a case expression.\npub type Pattern {\n  PBool(Bool)\n  PInt(Int)\n  PWildcard\n  PVar(String)\n  PList(elems: List(Pattern), rest: Option(String))\n}\n\n// ── Evaluation ────────────────────────────────────────────────────────────────\n\n/// Evaluate an expression in an environment.\nfn eval(expr: Expr, env: Env) -> Result(Value, EvalError) {\n  limits.charge(1)\n  case expr {\n    Var(name) -> lookup(env, name)\n    LiteralBool(b) -> Ok(VBool(b))\n    LiteralInt(n) -> Ok(VInt(n))\n    LiteralList(elems, rest) -> eval_list(elems, rest, env)\n    Call(fn_expr, operands) ->\n      // YOUR CODE HERE (replace the code below)\n      Error(errors.NotImplemented(\n        \"Call(\"\n        <> string.inspect(fn_expr)\n        <> \", \"\n        <> string.inspect(operands)\n        <> \")\",\n      ))\n    // Evaluate the expression v exactly once, then extend env to include\n    // the name bound to its value; finally, evaluate the body of the let.\n    Let(name, v, body) ->\n      case eval(v, env) {\n        Error(e) -> Error(e)\n        // YOUR CODE HERE (replace the code below)\n        Ok(value) ->\n          Error(errors.NotImplemented(\n            \"let \"\n            <> name\n            <> \" = \"\n            <> string.inspect(value)\n            <> \" in \"\n            <> string.inspect(body),\n          ))\n      }\n    Case(subject, arms) ->\n      // YOUR CODE HERE (replace the code below)\n      Error(errors.NotImplemented(\n        \"Case(\"\n        <> string.inspect(subject)\n        <> \", \"\n        <> string.inspect(arms)\n        <> \")\",\n      ))\n    Lambda(params, body) ->\n      // YOUR CODE HERE (replace the code below)\n      Error(errors.NotImplemented(\n        \"Lambda(\"\n        <> string.inspect(params)\n        <> \", \"\n        <> string.inspect(body)\n        <> \")\",\n      ))\n    FieldAccess(record, field) ->\n      case eval(record, env) {\n        Error(e) -> Error(e)\n        Ok(v) -> get_field(v, field)\n      }\n    // An error from this expression is on this line.\n    At(line, expr) -> result.map_error(eval(expr, env), errors.at_line(_, line))\n  }\n}\n\n/// Evaluate a list literal [a, b, ..rest].\nfn eval_list(\n  elems: List(Expr),\n  rest: Option(Expr),\n  env: Env,\n) -> Result(Value, EvalError) {\n  case list.try_map(elems, fn(e) { eval(e, env) }), rest {\n    Error(e), _ -> Error(e)\n    // YOUR CODE HERE (replace the code below)\n    Ok(head), None ->\n      Error(errors.NotImplemented(\"list of \" <> string.inspect(head)))\n    Ok(head), Some(r) ->\n      case eval(r, env) {\n        // YOUR CODE HERE (replace the code below)\n        Ok(VList(tail)) ->\n          Error(errors.NotImplemented(\n            \"list of \"\n            <> string.inspect(head)\n            <> \" then \"\n            <> string.inspect(tail),\n          ))\n        Ok(other) ->\n          Error(TypeError(\"`..` expects a list, got \" <> describe(other)))\n        Error(e) -> Error(e)\n      }\n  }\n}\n\n/// Apply a function value to already-evaluated arguments. Every application costs\n/// one step, even of a built-in.\npub fn apply(f: Value, args: List(Value)) -> Result(Value, EvalError) {\n  limits.charge(1)\n  case f {\n    VFunc(callable) -> {\n      let wanted = num_params(callable)\n      case list.length(args) == wanted {\n        False -> Error(wrong_num_args(callable.name, wanted, list.length(args)))\n        True ->\n          case callable {\n            Builtin(_, _, run) ->\n              // YOUR CODE HERE (replace the code below)\n              Error(errors.NotImplemented(\n                \"Builtin(\"\n                <> string.inspect(run)\n                <> \") with \"\n                <> string.inspect(args),\n              ))\n            UserFn(_, params, body, parent) ->\n              // YOUR CODE HERE (replace the code below)\n              Error(errors.NotImplemented(\n                \"UserFn(\"\n                <> string.inspect(params)\n                <> \", \"\n                <> string.inspect(body)\n                <> \", \"\n                <> string.inspect(parent)\n                <> \")\",\n              ))\n          }\n      }\n    }\n    _ -> Error(TypeError(\"calling a value that is not a function\"))\n  }\n}\n\n/// How many arguments a function takes.\nfn num_params(callable: Callable) -> Int {\n  case callable {\n    Builtin(_, num_args, _) -> num_args\n    UserFn(_, params, _, _) -> list.length(params)\n  }\n}\n\n/// The value of a record's field, found by its position in constructors.\nfn get_field(v: Value, field: String) -> Result(Value, EvalError) {\n  case v {\n    VData(tag, values) -> {\n      let names = result.unwrap(list.key_find(constructors, tag), [])\n      case list.key_find(list.zip(names, values), field) {\n        Ok(value) -> Ok(value)\n        Error(Nil) -> Error(TypeError(\"a \" <> tag <> \" has no .\" <> field))\n      }\n    }\n    _ ->\n      Error(TypeError(\".\" <> field <> \" expects a record, got \" <> describe(v)))\n  }\n}\n\n/// The value bound to name in env. A name is looked up exactly as in an\n/// environment diagram: check the current frame's bindings, then its\n/// parent's, and so on out to the Global frame. A name that no frame binds\n/// is an errors.UnboundVariable(name) error.\npub fn lookup(env: Env, name: String) -> Result(Value, EvalError) {\n  case env {\n    Local(bindings, parent) ->\n      // YOUR CODE HERE (replace the code below)\n      Error(errors.NotImplemented(\n        \"lookup(\"\n        <> name\n        <> \") in Local(\"\n        <> string.inspect(dict.keys(bindings))\n        <> \", \"\n        <> string.inspect(parent)\n        <> \")\",\n      ))\n    Global(bindings) ->\n      case mutable_dict.get(bindings, name) {\n        Ok(value) -> Ok(value)\n        Error(Nil) -> Error(errors.UnboundVariable(name))\n      }\n  }\n}\n\n// ── Pattern matching ──────────────────────────────────────────────────────────\n\n/// The bindings and body of the first arm whose pattern matches value, or\n/// Error(Nil) if no pattern matches.\npub fn find_arm(\n  value: Value,\n  arms: List(Arm),\n) -> Result(#(List(#(String, Value)), Expr), Nil) {\n  case arms {\n    [] -> Error(Nil)\n    [#(pattern, body), ..rest] ->\n      case match_pattern(pattern, value) {\n        Ok(bindings) -> Ok(#(bindings, body))\n        Error(Nil) -> find_arm(value, rest)\n      }\n  }\n}\n\n/// The names that pattern binds if it matches value, or Error(Nil) if it doesn't.\nfn match_pattern(\n  pattern: Pattern,\n  value: Value,\n) -> Result(List(#(String, Value)), Nil) {\n  case pattern, value {\n    PBool(b1), VBool(b2) if b1 == b2 -> Ok([])\n    PInt(n1), VInt(n2) if n1 == n2 -> Ok([])\n    PWildcard, _ -> Ok([])\n    // YOUR CODE HERE\n    PList(elems, rest), VList(vs) -> match_list(elems, rest, vs)\n    _, _ -> Error(Nil)\n  }\n}\n\n/// The names that the list pattern [elems, ..rest] binds if it matches the values\n/// vs, or Error(Nil) if it doesn't.\nfn match_list(\n  elems: List(Pattern),\n  rest: Option(String),\n  vs: List(Value),\n) -> Result(List(#(String, Value)), Nil) {\n  case elems, rest, vs {\n    [], None, [] -> Ok([])\n    // YOUR CODE HERE (replace the code below)\n    [], Some(x), _ -> {\n      let _ = x\n      Error(Nil)\n    }\n    // YOUR CODE HERE\n    _, _, _ -> Error(Nil)\n  }\n}\n\n// ── Running a program ─────────────────────────────────────────────────────────\n\n/// Call the function named function in the global frame on args.\npub fn run(\n  function: String,\n  args: List(Value),\n  global: GlobalFrame,\n) -> Result(Value, EvalError) {\n  use <- limits.guarded\n  // The function's body is evaluated here rather than through apply, so that\n  // a program runs even before apply can call user-defined functions.\n  case mutable_dict.get(global, function) {\n    Ok(VFunc(UserFn(_, params, body, env))) ->\n      case list.length(params) == list.length(args) {\n        True -> eval(body, Local(dict.from_list(list.zip(params, args)), env))\n        False -> Error(MissingFunction(function, list.length(args)))\n      }\n    _ -> Error(MissingFunction(function, list.length(args)))\n  }\n}\n\n// ── Helpers ──────────────────────────────────────────────────────────────────\n\n/// The environment with the `new` bindings added to the current frame, each\n/// replacing any earlier binding of the same name in that frame. A let and a\n/// case arm bind this way.\npub fn extend(env: Env, new: List(#(String, Value))) -> Env {\n  case env {\n    Local(existing, parent) ->\n      Local(dict.merge(existing, dict.from_list(new)), parent)\n    // Global is never extended\n    Global(_) -> env\n  }\n}\n\n/// Construct a TypeError when a function is called on the wrong # of arguments.\nfn wrong_num_args(function_name: String, wanted: Int, got: Int) -> EvalError {\n  TypeError(\n    function_name\n    <> \" takes \"\n    <> int.to_string(wanted)\n    <> \" argument(s) but was given \"\n    <> int.to_string(got),\n  )\n}\n\n/// A short description for error messages that omits list or record contents.\nfn describe(v: Value) -> String {\n  case v {\n    VList(_) -> \"a list\"\n    VData(tag, _) -> \"a \" <> tag <> \" record\"\n    VFunc(f) -> \"the function \" <> f.name\n    _ -> string.inspect(v)\n  }\n}\n","line_count":382,"path":"src\\evaluator.gleam","sha256":"38d926e334ac78f439f2526598223d04735e23e9fee7ebf66dc3adca55b1b9a0"},"hash":"3bf04f6f7a588ee1c94ca582a5e4d07a0b29774ddd521c5765d199822ad874bb","kind":"doc.open","prev_hash":"179294ebf0c0d73bf1229752d259077de3768b109b2007b4f78906ca5a1bfe78","seq":80,"t":242998,"wall":"2026-11-06T21:59:43.436Z"}
