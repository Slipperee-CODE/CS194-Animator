endry.code-runner","version":"0.12.2"},{"enabled":true,"id":"gleam.gleam","version":"2.13.1"},{"enabled":false,"id":"itsgeagle.provenance-recorder","version":"2.0.2"},{"enabled":false,"id":"mcu-debug.peripheral-viewer","version":"1.6.5"},{"enabled":false,"id":"ms-python.debugpy","version":"2026.6.0"},{"enabled":false,"id":"ms-python.python","version":"2026.10.0"},{"enabled":false,"id":"ms-python.vscode-pylance","version":"2026.4.1"},{"enabled":false,"id":"ms-python.vscode-python-envs","version":"1.44.0"},{"enabled":false,"id":"ms-toolsai.jupyter","version":"2025.9.1"},{"enabled":false,"id":"ms-toolsai.jupyter-keymap","version":"1.1.2"},{"enabled":false,"id":"ms-toolsai.jupyter-renderers","version":"1.3.0"},{"enabled":false,"id":"ms-toolsai.vscode-jupyter-cell-tags","version":"0.1.9"},{"enabled":false,"id":"ms-toolsai.vscode-jupyter-slideshow","version":"0.1.6"},{"enabled":false,"id":"ms-vscode.cmake-tools","version":"1.25.10"},{"enabled":false,"id":"ms-vscode.cpp-devtools","version":"0.7.2"},{"enabled":false,"id":"ms-vscode.cpptools","version":"1.35.6"},{"enabled":false,"id":"ms-vscode.cpptools-extension-pack","version":"1.5.1"},{"enabled":false,"id":"ms-vscode.cpptools-themes","version":"2.0.0"},{"enabled":false,"id":"ms-vscode.vscode-serial-monitor","version":"0.13.1"},{"enabled":false,"id":"paulober.pico-w-go","version":"4.6.1"},{"enabled":false,"id":"ritwickdey.LiveServer","version":"5.7.10"},{"enabled":false,"id":"rust-lang.rust-analyzer","version":"0.3.3121"},{"enabled":false,"id":"tomoki1207.pdf","version":"1.2.2"}]},"hash":"768a89d54a1ac315a78e91684ee4c789829536ae421ee3a18db41ad45c32261d","kind":"ext.snapshot","prev_hash":"691d8a84a56deccf18f7838d8a2728b3578ca87ef87c7af32cbfe11b85c91c07","seq":2,"t":6,"wall":"2026-11-23T06:43:53.682Z"}
